extends ../layouts/base.pug

block content
    main.page-layout 
        include ../layouts/pagemenu.pug

        .main
            div
                h1.page-heading institutional committees
                p At Iqbal Institute of Technology and Management, we believe in fostering a collaborative and inclusive environment...

                //- Statutory Committees Section
                if statutoryCommittees && statutoryCommittees.length > 0
                    .line-above-heading 
                    h3.heading-with-top-border Statutory Committees

                    each committee in statutoryCommittees
                        a(href=committee.detailUrl style="text-decoration: none; color: inherit;")
                            .text-card
                                .text-card__heading.margin-bottom-xs
                                    span= committee.name
                                
                                if committee.descriptionPoints.length > 0
                                    ul.star-ul
                                        each point in committee.descriptionPoints
                                            li= point
                                
                                if committee.members.length > 0
                                    .text-card__footer.margin-top-xs
                                        each member in committee.members
                                            div
                                                svg(fill='#9fa4aa' xmlns='http://www.w3.org/2000/svg' viewbox='0 0 512 512')
                                                    path(d='M304 128a80 80 0 1 0 -160 0 80 80 0 1 0 160 0zM96 128a128 128 0 1 1 256 0A128 128 0 1 1 96 128zM49.3 464H398.7c-8.9-63.3-63.3-112-129-112H178.3c-65.7 0-120.1 48.7-129 112zM0 482.3C0 383.8 79.8 304 178.3 304h91.4C368.2 304 448 383.8 448 482.3c0 16.4-13.3 29.7-29.7 29.7H29.7C13.3 512 0 498.7 0 482.3z')
                                                | #{member}

                //- Non-Statutory Committees Section
                if nonStatutoryCommittees && nonStatutoryCommittees.length > 0
                    .line-above-heading 
                    h3.heading-with-top-border Non-Statutory Committees

                    each committee in nonStatutoryCommittees
                        a(href=committee.detailUrl style="text-decoration: none; color: inherit;")
                            .text-card
                                .text-card__heading.margin-bottom-xs
                                    span= committee.name
                                
                                if committee.descriptionPoints.length > 0
                                    ul.star-ul
                                        each point in committee.descriptionPoints
                                            li= point
                                
                                if committee.members.length > 0
                                    .text-card__footer.margin-top-xs
                                        each member in committee.members
                                            div
                                                svg(fill='#9fa4aa' xmlns='http://www.w3.org/2000/svg' viewbox='0 0 512 512')
                                                    path(d='M304 128a80 80 0 1 0 -160 0 80 80 0 1 0 160 0zM96 128a128 128 0 1 1 256 0A128 128 0 1 1 96 128zM49.3 464H398.7c-8.9-63.3-63.3-112-129-112H178.3c-65.7 0-120.1 48.7-129 112zM0 482.3C0 383.8 79.8 304 178.3 304h91.4C368.2 304 448 383.8 448 482.3c0 16.4-13.3 29.7-29.7 29.7H29.7C13.3 512 0 498.7 0 482.3z')
                                                | #{member}

                if (!statutoryCommittees || statutoryCommittees.length === 0) && (!nonStatutoryCommittees || nonStatutoryCommittees.length === 0)
                    .text-card
                        p No committees available at the moment.