extends ../layouts/base.pug

block styles 
    meta(name="og:title", content="IITM - Institutional Committees")
    meta(name="og:description", content="Explore the various statutory and non-statutory committees at Iqbal Institute of Technology and Management (IITM) that contribute to our institution's governance and operations.")
    meta(name="description", content="Discover the committees that help shape policies and initiatives at IITM through collaborative decision-making and specialized focus areas.")

block content
    main.page-layout 
        include ../layouts/pagemenu.pug
        .main
            div.margin-top-sm.margin-bottom-lg
                h1.margin-bottom-sm Institutional Committees
                p At Iqbal Institute of Technology and Management, we believe in fostering a collaborative and inclusive environment through various committees that contribute to our institution's governance and operations.

                //- Statutory Committees Section
                if statutoryCommittees && statutoryCommittees.length > 0
                    .line-above-heading 
                    h2.heading-with-top-border Statutory Committees

                    .square-cards
                        each committee in statutoryCommittees
                            .square-cards__item
                                a(href=committee.detailUrl)
                                    img(src="/data/imgs/criteria.png", alt=committee.name)
                                    div
                                        h2= committee.name

                //- Non-Statutory Committees Section
                if nonStatutoryCommittees && nonStatutoryCommittees.length > 0
                    .line-above-heading 
                    h2.heading-with-top-border Non-Statutory Committees

                    .square-cards
                        each committee in nonStatutoryCommittees
                            .square-cards__item
                                a(href=committee.detailUrl)
                                    img(src="/data/imgs/criteria.png", alt=committee.name)
                                    div
                                        h2= committee.name

                if (!statutoryCommittees || statutoryCommittees.length === 0) && (!nonStatutoryCommittees || nonStatutoryCommittees.length === 0)
                    .text-card
                        p No committees available at the moment.