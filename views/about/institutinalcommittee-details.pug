extends ../layouts/base.pug

block content
    main.page-layout 
        include ../layouts/pagemenu.pug

        .main
            div
                //- Back button
                a.btn.btn-secondary.mb-4(href="/about/institutional-committees") 
                    | ← Back to Committees

                //- Committee Details Card
                //- .text-card
                //-     .text-card__heading.margin-bottom-xs
                //-         span= committee.name
                //-         if committee.type
                //-             small.badge.ml-2(class=committee.type === 'statutory' ? 'badge-primary' : 'badge-secondary')
                //-                 = committee.type
                    
                //-     if committee.descriptionPoints.length > 0
                //-         h5.mt-4 Description:
                //-         ul.star-ul
                //-             each point in committee.descriptionPoints
                //-                 li= point
                    
                //-     if committee.members.length > 0
                //-         h5.mt-4 Members:
                //-         .text-card__footer.margin-top-xs
                //-             each member in committee.members
                //-                 div.mb-2
                //-                     svg(fill='#9fa4aa' xmlns='http://www.w3.org/2000/svg' viewbox='0 0 512 512')
                //-                         path(d='M304 128a80 80 0 1 0 -160 0 80 80 0 1 0 160 0zM96 128a128 128 0 1 1 256 0A128 128 0 1 1 96 128zM49.3 464H398.7c-8.9-63.3-63.3-112-129-112H178.3c-65.7 0-120.1 48.7-129 112zM0 482.3C0 383.8 79.8 304 178.3 304h91.4C368.2 304 448 383.8 448 482.3c0 16.4-13.3 29.7-29.7 29.7H29.7C13.3 512 0 498.7 0 482.3z')
                //-                     | #{member}

                //- PDF Viewer Section (if PDF exists)
                if committee.pdf_filepath
                    .pdf-container.mt-5
                        iframe.pdf-viewer.hidden(src=committee.pdf_filepath)
                        .pdf.margin-top-sm.hidden
                        .pdf-download
                            a.download-btn(href=committee.pdf_filepath, download=committee.original_filename)
                                ion-icon(name="download-outline")
                                span Download PDF

                        .meeting-meta
                            .meta-item
                                ion-icon(name="calendar-outline")
                                span= new Date(committee.updated_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
                            .meta-item
                                ion-icon(name="document-outline")
                                span PDF Document
                            .meta-item
                                ion-icon(name="time-outline")
                                span= committee.formattedFileSize || 'Size N/A'

    //- PDF.js script for PDF rendering
    if committee.pdf_filepath
        script.
            // Initialize PDF viewer
            pdfJs(["#{committee.pdf_filepath}"]);

    style.
        .pdf-container {
            margin: 2rem 0;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        }

        .pdf-download {
            text-align: center;
            padding: 1.5rem;
            background: #f8fafc;
            border-top: 1px solid #e2e8f0;
        }

        .download-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 1.5rem;
            background: #2563eb;
            color: white;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .download-btn:hover {
            background: #1d4ed8;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
        }

        .download-btn ion-icon {
            font-size: 1.25rem;
        }

        .meeting-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 1.5rem;
            margin: 1.5rem 0 2rem;
            padding: 1.25rem;
            background: #f1f5f9;
            border-radius: 12px;
        }

        .meta-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: #475569;
            font-size: 0.95rem;
        }

        .meta-item ion-icon {
            color: #64748b;
        }

        @media (max-width: 768px) {
            .meeting-meta {
                flex-direction: column;
                gap: 0.75rem;
            }
            
            .download-btn {
                width: 100%;
                justify-content: center;
            }
        }