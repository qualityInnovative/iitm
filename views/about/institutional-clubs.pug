extends ../layouts/base.pug

block styles 
  meta(name="og:title", content="IITM - Institutional Clubs")
  meta(name="og:description", content="Explore the vibrant club culture at Iqbal Institute of Technology and Management (IITM). Our clubs provide students with opportunities for leadership, teamwork, and skill development beyond the classroom.")
  meta(name="description", content="Discover various institutional clubs at IITM that help students develop social skills, teamwork, and practical experience through engaging activities and events.")
  style.
    .club-icon {
      height: 20px;
      width: 20px;
      margin-right: 5px;
      vertical-align: middle;
    }
    .club-meta {
      position: absolute;
      bottom: 20px;
      left: 20px;
      display: flex;
      align-items: flex-start;
      
      color: white;
      padding: 3px 8px;
      border-radius: 12px;
      font-size: 0.8rem;
    }
    .square-cards__item {
      position: relative;
    }
   

block content
  main.page-layout 
    include ../layouts/pagemenu.pug
    .main
      div.margin-top-sm.margin-bottom-lg
        h1.margin-bottom-sm Institutional Clubs
        p Club activities help students develop a sense of unity and teamwork while also learning how to collaborate with others to achieve common goals. These activities provide an excellent opportunity for students to develop social skills and interact with their peers in a constructive and engaging environment. At our college, we recognize the importance of practical experience and its contribution to a well-rounded education. The student clubs on our campus are specifically designed to nurture and groom student skills, providing them with hands-on experience that complements their academic pursuits. Our clubs offer a wealth of opportunities for student leadership and participation beyond the traditional classroom setting, allowing students to explore their passions and interests while making a meaningful impact. We firmly believe that the success and smooth functioning of our student clubs are driven by the active involvement and dedication of our members. Join us in embracing this enriching journey of personal and professional growth, where the possibilities are endless.

        .line-above-heading 
        h2.heading-with-top-border Explore Clubs

        .square-cards
          if clubs && clubs.length > 0
            each club in clubs
              .square-cards__item
                a(href=`/about/institutional-clubs/${club.id}`)
                  img(src="/data/imgs/criteria.png", alt=club.name)
                  div
                    h2= club.name
                