extends ../layouts/cms-base.pug

block styles
  style.
    /* Club Management Styles */
    .club-management {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      max-width: 1200px;
      padding: 30px;
      margin: 0 auto;
      color: #333;
    }

    .club-header {
      color: #2c3e50;
      border-bottom: 2px solid #3498db;
      padding-bottom: 10px;
      margin-bottom: 25px;
      text-align: center;
      font-weight: 600;
    }

    /* Add New Button Styles */
    .btn-add-new {
      background-color: #3498db;
      border-color: #3498db;
      transition: all 0.3s ease;
      padding: 10px 20px;
      font-weight: 500;
      letter-spacing: 0.5px;
      box-shadow: 0 2px 5px rgba(52, 152, 219, 0.3);
      display: inline-flex;
      align-items: center;
      border-radius: 6px;
    }

    .btn-add-new:hover {
      background-color: #2980b9;
      border-color: #2980b9;
      transform: translateY(-2px);
      box-shadow: 0 4px 8px rgba(52, 152, 219, 0.4);
    }

    .btn-add-new:active {
      transform: translateY(0);
      box-shadow: 0 2px 3px rgba(52, 152, 219, 0.3);
    }

    .btn-add-new i {
      font-size: 1.1rem;
      margin-right: 8px;
    }

    /* Alert Close Button Styles */
    .alert .close {
      position: absolute;
      top: 50%;
      right: 20px;
      transform: translateY(-50%);
      color: inherit;
      opacity: 0.7;
      background: transparent;
      border: none;
      font-size: 1.5rem;
      line-height: 1;
      padding: 0;
      cursor: pointer;
      transition: opacity 0.2s;
    }

    .alert .close:hover {
      opacity: 1;
    }

    .club-card {
      border-radius: 8px;
      padding:20px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      border: none;
      margin-bottom: 20px;
      overflow: hidden;
    }

    .club-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
    }

    .card-title {
      color: #2c3e50;
      font-weight: 600;
      margin-bottom: 15px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .order-badge {
      background-color: #7f8c8d;
      font-size: 0.8rem;
      font-weight: normal;
      padding: 5px 10px;
      border-radius: 4px;
    }

    .card-text {
      color: #555;
      margin-bottom: 15px;
    }

    .members-list {
      background-color: #f8f9fa;
      padding: 10px;
      border-radius: 5px;
      font-size: 0.9rem;
    }

    .documents-list {
      margin: 15px 0;
    }

    .document-item {
      padding: 10px;
      border-radius: 5px;
      background-color: #f8f9fa;
    }

    .document-link {
      color: #e74c3c;
      text-decoration: none;
      transition: color 0.2s;
    }

    .document-link:hover {
      color: #c0392b;
      text-decoration: underline;
    }

    .document-icon {
      margin-right: 8px;
    }

    .upload-date {
      font-size: 0.8rem;
      color: #7f8c8d;
    }

    .action-buttons {
      display: flex;
      gap: 10px;
      margin-top: 20px;
    }

    .btn-edit {
      background-color: #2ecc71;
      border-color: #2ecc71;
    }

    .btn-edit:hover {
      background-color: #27ae60;
      border-color: #27ae60;
    }

    .no-clubs {
      text-align: center;
      padding: 20px;
      background-color: #f8f9fa;
      border-radius: 8px;
    }

    /* Responsive adjustments */
    @media (max-width: 768px) {
      .club-management {
        padding: 15px;
      }
      
      .club-header {
        font-size: 1.5rem;
      }
      
      .action-buttons {
        flex-direction: column;
      }
      
      .btn {
        width: 100%;
        margin-bottom: 5px;
      }
    }

block content
  .club-management
    h1.club-header Institutional Clubs Management
    
   
    
    a.btn.btn-primary.btn-add-new.mb-4(href="/cms/institutionclubs/new")
      i.bi.bi-plus-circle.me-2
      | Add New Club
    
    if clubs && clubs.length > 0
      .row
        each club in clubs
          .col-md-6.mb-4
            .card.club-card.h-100
              .card-body
                h5.card-title
                  = club.name
                  if club.display_order
                    span.badge.badge-secondary.order-badge Order: #{club.display_order}
                p.card-text.text-muted.mb-3= club.description
                h6.font-weight-bold Members:
                p.members-list.mb-3= club.members
                
                if club.pdf_filepath
                  .documents-list
                    h6.font-weight-bold.mb-3 Attached Document:
                    ul.list-group.list-group-flush
                      li.list-group-item.document-item
                        .d-flex.justify-content-between.align-items-center
                          a.document-link(href=club.pdf_filepath target="_blank")
                            i.bi.bi-file-earmark-pdf.document-icon
                            span View PDF Document
                          span.upload-date= new Date(club.updated_at).toLocaleDateString()
                
                .action-buttons
                  a.btn.btn-info.btn-edit(href=`/cms/institutionclubs/edit/${club.id}`)
                    i.bi.bi-pencil.me-1
                    | Edit
                  form.d-inline(method="POST" action=`/cms/institutionclubs/delete/${club.id}`)
                    button.btn.btn-danger(type="submit" onclick="return confirm('Are you sure you want to delete this club?')")
                      i.bi.bi-trash.me-1
                      | Delete
    else
      .alert.alert-info.no-clubs No institutional clubs found.

block scripts
  script.
    // Initialize Bootstrap alert dismissal
    document.addEventListener('DOMContentLoaded', function() {
      // Manual close button functionality
      document.querySelectorAll('[data-bs-dismiss="alert"]').forEach(button => {
        button.addEventListener('click', function() {
          const alert = this.closest('.alert');
          if (alert) {
            bootstrap.Alert.getOrCreateInstance(alert).close();
          }
        });
      });
      
      // Auto-dismiss alerts after 5 seconds
      setTimeout(() => {
        const alerts = document.querySelectorAll('.alert');
        alerts.forEach(alert => {
          bootstrap.Alert.getOrCreateInstance(alert).close();
        });
      }, 5000);
    });