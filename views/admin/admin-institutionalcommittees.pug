extends ../layouts/cms-base.pug

block styles
  style.
    .committee-management {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      max-width: 1200px;
      padding: 30px;
      margin: 0 auto;
    }
    .committee-header {
      color: #2c3e50;
      border-bottom: 2px solid #3498db;
      padding-bottom: 10px;
      margin-bottom: 25px;
      text-align: center;
    }
    .committee-card {
      border-radius: 8px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      border: none;
      margin-bottom: 20px;
    }
    .committee-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
    }
    .committee-card .card-body {
      padding: 1.5rem;
    }
    .committee-card .card-title {
      color: #2980b9;
      font-weight: 600;
      margin-bottom: 1rem;
    }
    .members-list {
      background-color: #f8f9fa;
      padding: 12px;
      border-radius: 6px;
      font-size: 0.95rem;
      white-space: pre-line;
    }
    .documents-list {
      margin-top: 1.5rem;
    }
    .document-item {
      transition: background-color 0.2s ease;
      padding: 10px 15px;
    }
    .document-item:hover {
      background-color: #f1f8ff;
    }
    .document-link {
      color: #2c3e50;
      text-decoration: none;
      display: flex;
      align-items: center;
    }
    .document-link:hover {
      color: #2980b9;
      text-decoration: underline;
    }
    .action-buttons {
      margin-top: 1.5rem;
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }
    .btn-edit {
      background-color: #3498db;
      border-color: #3498db;
    }
    .btn-edit:hover {
      background-color: #2980b9;
      border-color: #2980b9;
    }
    .no-committees {
      background-color: #e7f5ff;
      border-color: #d0ebff;
      padding: 15px;
      border-radius: 5px;
    }
    .section-title {
      color: #2c3e50;
      margin-top: 2.5rem;
      margin-bottom: 1.5rem;
      font-weight: 600;
      text-align: center;
    }
    .upload-date {
      font-size: 0.85rem;
      color: #7f8c8d;
    }
    .btn-add-new {
      background-color: #2ecc71;
      border-color: #2ecc71;
      font-weight: 500;
      display: block;
      width: fit-content;
      margin: 0 auto 30px;
    }
    .btn-add-new:hover {
      background-color: #27ae60;
      border-color: #27ae60;
    }
    .document-icon {
      margin-right: 8px;
      font-size: 1.1rem;
    }
    .badge-type {
      font-size: 0.8rem;
      margin-left: 10px;
      vertical-align: middle;
    }
    .order-badge {
      background-color: #6c757d;
      margin-left: 10px;
    }

block content
  .committee-management
    h1.committee-header Institutional Committees Management
    
    a.btn.btn-secoundry.mb-4(href="/cms/institutioncommittees/new")
      i.bi.bi-plus-circle.me-2
      | Add New Committee
    
    h2.section-title Statutory Committees
    if statutoryCommittees && statutoryCommittees.length > 0
      .row
        each committee in statutoryCommittees
          .col-md-6.mb-4
            .card.committee-card.h-100
              .card-body
                h5.card-title
                  = committee.name
                  span.badge.badge-primary.badge-type= committee.type
                  if committee.display_order
                    span.badge.badge-secondary.order-badge Order: #{committee.display_order}
                //- p.card-text.text-muted.mb-3= committee.description
                //- h6.font-weight-bold Members:
                //- p.members-list.mb-3= committee.members
                
                if committee.pdf_filepath
                  .documents-list
                    h6.font-weight-bold.mb-3 Attached Document:
                    ul.list-group.list-group-flush
                      li.list-group-item.document-item
                        .d-flex.justify-content-between.align-items-center
                          a.document-link(href=committee.pdf_filepath target="_blank")
                            i.bi.bi-file-earmark-pdf.document-icon
                            span View PDF Document
                          span.upload-date= new Date(committee.updated_at).toLocaleDateString()
                
                .action-buttons
                  a.btn(href=`/cms/institutioncommittees/edit/${committee.id}`)
                    i.bi.bi-pencil.me-1
                    | Edit
                  form.d-inline(method="POST" action=`/cms/institutioncommittees/delete/${committee.id}`)
                    button.btn(type="submit" onclick="return confirm('Are you sure you want to delete this committee?')")
                      i.bi.bi-trash.me-1
                      | Delete
    else
      .alert.alert-info.no-committees No statutory committees found.
    
    h2.section-title Non-Statutory Committees
    if nonStatutoryCommittees && nonStatutoryCommittees.length > 0
      .row
        each committee in nonStatutoryCommittees
          .col-md-6.mb-4
            .card.committee-card.h-100
              .card-body
                h5.card-title
                  = committee.name
                  span.badge.badge-info.badge-type= committee.type
                  if committee.display_order
                    span.badge.badge-secondary.order-badge Order: #{committee.display_order}
                p.card-text.text-muted.mb-3= committee.description
                h6.font-weight-bold Members:
                p.members-list.mb-3= committee.members
                
                if committee.pdf_filepath
                  .documents-list
                    h6.font-weight-bold.mb-3 Attached Document:
                    ul.list-group.list-group-flush
                      li.list-group-item.document-item
                        .d-flex.justify-content-between.align-items-center
                          a.document-link(href=committee.pdf_filepath target="_blank")
                            i.bi.bi-file-earmark-pdf.document-icon
                            span View PDF Document
                          span.upload-date= new Date(committee.updated_at).toLocaleDateString()
                
                .action-buttons
                  a.btn.btn-info.btn-edit(href=`/cms/institutioncommittees/edit/${committee.id}`)
                    i.bi.bi-pencil.me-1
                    | Edit
                  form.d-inline(method="POST" action=`/cms/institutioncommittees/delete/${committee.id}`)
                    button.btn.btn-danger(type="submit" onclick="return confirm('Are you sure you want to delete this committee?')")
                      i.bi.bi-trash.me-1
                      | Delete
    else
      .alert.alert-info.no-committees No non-statutory committees found.